# -----------------------------------------------------------------------------
# AgriSphere OS - Example Configuration File
# Copy this file to .env and configure appropriate values for your environment
# -----------------------------------------------------------------------------

# Application Runtime
APP_NAME=AgriSphere Smart Agriculture Platform
APP_VERSION=2.5.0
DEBUG=false
HOST=0.0.0.0
PORT=8085

# Database Connection (SQLite / PostgreSQL / TimescaleDB)
DATABASE_URL=sqlite:///./agrisphere.db

# In-Memory Cache & Telemetry Broker
REDIS_URL=redis://localhost:6379/0

# IoT Telemetry Settings
TELEMETRY_INTERVAL_SECONDS=2.5
DEFAULT_ZONES_COUNT=4

# Default Farm Coordinates (Hyderabad, India)
DEFAULT_LOCATION=Hyderabad, India
DEFAULT_LATITUDE=17.3850
DEFAULT_LONGITUDE=78.4867

# Security & CORS Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
CORS_ORIGINS=["*"]

# External Satellite & Weather API Keys (Optional)
SENTINEL_HUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_HUB_CLIENT_SECRET=your-sentinel-hub-client-secret
OPENWEATHER_API_KEY=your-openweather-api-key
